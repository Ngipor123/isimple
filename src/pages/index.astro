<script>
  // Live open/closed status for T/C Sāga (Mon–Sat 10:00–21:00, Sun 10:00–20:00, Riga time)
  (function () {
    const dot = document.getElementById('status-dot');
    const text = document.getElementById('status-text');
    const wrapper = document.getElementById('branch-status');
    if (!dot || !text || !wrapper) return;

    // Intl.DateTimeFormat instead of new Date(toLocaleString(...)):
    // parsing a localized string is non-standard and returns Invalid Date in Safari/iOS.
    let weekday, hours, minutes;
    try {
      const parts = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Europe/Riga',
        weekday: 'short',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      }).formatToParts(new Date());
      const get = (type) => (parts.find((p) => p.type === type) || {}).value;
      weekday = get('weekday');
      hours = parseInt(get('hour'), 10);
      minutes = parseInt(get('minute'), 10);
    } catch (e) {
      return;
    }
    if (isNaN(hours) || isNaN(minutes)) return;
    if (hours === 24) hours = 0; // some engines format midnight as 24

    const closesAt = weekday === 'Sun' ? 20 : 21;
    const totalMinutes = hours * 60 + minutes;
    const isOpen = totalMinutes >= 10 * 60 && totalMinutes < closesAt * 60;

    if (isOpen) {
      dot.classList.add('bg-green-500');
      wrapper.classList.add('bg-green-950/20', 'border-green-900/50', 'text-green-400');
      text.textContent = `Atvērts šodien · Slēdzas plkst. ${closesAt}:00`;
    } else {
      dot.classList.add('bg-red-500');
      wrapper.classList.add('bg-red-950/20', 'border-red-900/50', 'text-red-400');
      text.textContent = `Slēgts · Atveras plkst. 10:00`;
    }
  })();
</script>
