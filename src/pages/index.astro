---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import ContactForm from '../components/ContactForm.astro';
import { getIPhoneModels, getServices, getPosts } from '../lib/sanity';
import { useTranslations, getLocalizedPath } from '../lib/i18n';

// Language configuration
const lang = 'lv';
const t = useTranslations(lang);

// Fetch data
const rawModels = await getIPhoneModels();
const services = await getServices();
const posts = await getPosts();

// Build iPhone models specifically for our structure
const models = rawModels.map(m => ({
  name: m.name,
  slug: m.slug,
  prices: m.prices
}));

// Process steps
const processSteps = [
  { num: '01', title: t('process.step1_title'), desc: t('process.step1_desc') },
  { num: '02', title: t('process.step2_title'), desc: t('process.step2_desc') },
  { num: '03', title: t('process.step3_title'), desc: t('process.step3_desc') },
  { num: '04', title: t('process.step4_title'), desc: t('process.step4_desc') },
  { num: '05', title: t('process.step5_title'), desc: t('process.step5_desc') },
];

// FAQ items
const faqItems = [
  { q: t('faq.q1'), a: t('faq.a1') },
  { q: t('faq.q2'), a: t('faq.a2') },
  { q: t('faq.q3'), a: t('faq.a3') },
  { q: t('faq.q4'), a: t('faq.a4') },
  { q: t('faq.q5'), a: t('faq.a5') },
];
---

<BaseLayout
  title="iSimple.lv — iPhone, iPad, Datoru remonts Rīgā, Dreiliņos"
  description="Profesionāls iPhone, iPad un datoru serviss Dreiliņos. Ātrs ekrāna un bateriju remonts ar garantiju. Zemas cenas un augsta kvalitāte."
  lang={lang}
>
  <!-- Hero Section -->
  <section class="bg-graphite-header pt-16 pb-12 md:pt-24 md:pb-16 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

        <!-- Left column: text content -->
        <div class="lg:col-span-7">
          <p class="section-label mb-5">Servisa centrs · T/C Sāga, Biķeru iela 4, Dreiliņi, Rīga</p>

          <h1 class="display-heading max-w-4xl mb-6">
            Mobilo tālruņu un datoru remonts <span class="text-brand-orange">Rīgā</span>
          </h1>

          <p class="text-lg text-text-secondary max-w-2xl mb-8 leading-relaxed">
            Mūsu servisa centrā iSimple veicam ātru un profesionālu visu zīmolu viedtālruņu, planšetdatoru un datoru remontu. Diagnostika pie mums ir bez maksas, un lielāko daļu bojājumu novēršam tajā pašā dienā.
          </p>

          <!-- Google Reviews badge -->
          <div class="inline-flex items-center gap-3 mb-8 bg-graphite-surface border border-white/10 rounded-lg px-4 py-3">
            <!-- Google G icon -->
            <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            <div class="flex items-center gap-2">
              <!-- Stars -->
              <div class="flex gap-0.5" aria-label="Novērtējums 5 no 5">
                {[1,2,3,4,5].map(() => (
                  <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>
              <span class="font-bold text-text-primary text-sm">{t('hero.reviews_rating')}</span>
              <span class="text-text-muted text-sm">·</span>
              <span class="text-text-secondary text-sm">{t('hero.reviews_badge')}</span>
              <span class="text-text-muted text-sm">·</span>
              <span class="text-text-secondary text-sm">{t('hero.reviews_count')}</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mb-10">
            <a
              href="tel:+37122487593"
              class="inline-flex items-center justify-center gap-2 bg-brand-orange hover:bg-brand-orange-hover text-graphite-header font-extrabold text-base py-3.5 px-6 rounded-lg transition-all duration-150 active:scale-[0.98] w-full sm:w-auto"
            >
              📞 Zvanīt: +371 22 487 593
            </a>
            <a 
              href="/kontakti/" 
              class="inline-flex items-center justify-center gap-2 px-5 py-3.5 bg-transparent border border-white/20 hover:bg-white/5 text-text-primary font-semibold rounded-lg text-sm transition-all duration-150 active:scale-[0.98] w-full sm:w-auto text-center"
            >
              Pieteikt remontu
            </a>
          </div>

          <!-- Stats strip -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-y-2 gap-x-6 p-4 bg-graphite-surface border border-white/10 rounded-lg text-sm text-text-secondary font-medium">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-orange"></span>
              <span>Ātrākais remonts: <strong class="text-text-primary font-semibold">20 min</strong></span>
            </div>
            <span class="hidden md:inline text-white/10">|</span>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-orange"></span>
              <span>Garantija: <strong class="text-text-primary font-semibold">6 mēn.</strong></span>
            </div>
            <span class="hidden md:inline text-white/10">|</span>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-orange"></span>
              <span>Diagnostika: <strong class="text-text-primary font-semibold">Bezmaksas</strong></span>
            </div>
          </div>
        </div>

        <!-- Right column: repair photo -->
        <div class="lg:col-span-5">
          <div class="relative w-full max-w-[450px] mx-auto lg:max-w-none">
            <img
              src="/images/ifixit_raper.webp"
              alt="iSimple remonts"
              class="w-full h-auto max-h-[380px] object-cover rounded-lg border border-white/10 aspect-[4/3]"
              width="480"
              height="360"
              loading="eager"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="pt-16 pb-20 bg-graphite-bg border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12">
        <p class="section-label mb-3">Ko mēs labojam</p>
        <h2 class="section-heading max-w-xl">
          Pilns remonta serviss jūsu iekārtai ar <span class="text-brand-orange">garantiju</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- 1. Telefonu Card -->
        <div
          class="card card-hover flex flex-col justify-between overflow-hidden relative min-h-[340px] rounded-lg"
          style="background-image: url('/images/service-iphone.png'); background-size: cover; background-position: center;"
        >
          <div class="absolute inset-0 bg-brand-dark/75"></div>
          <div class="relative z-10 p-6 flex flex-col justify-between h-full text-white">
            <div>
              <div class="w-10 h-10 rounded-lg bg-white/20 flex items-center justify-center text-white mb-4">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                </svg>
              </div>
              <h3 class="font-display font-bold text-white text-xl mb-2">Telefonu Remonts</h3>
              <p class="text-white/80 text-xs sm:text-sm leading-relaxed">
                Profesionāls iPhone, Samsung, Huawei, Xiaomi un citu zīmolu viedtālruņu remonts. Ekrānu un bateriju nomaiņa no 20 minūtēm ar 6 mēnešu garantiju.
              </p>
            </div>
            <div class="pt-4 border-t border-white/20 flex gap-4">
              <a
                href="/iphone-remonts/"
                class="text-xs font-bold text-white hover:text-brand-orange hover:underline decoration-brand-orange/50 underline-offset-4 inline-flex items-center gap-0.5 transition-all duration-150"
              >
                iPhone cenas
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
              <a
                href="/telefonu-remonts/"
                class="text-xs font-bold text-white hover:text-brand-orange hover:underline decoration-brand-orange/50 underline-offset-4 inline-flex items-center gap-0.5 transition-all duration-150"
              >
                Android cenas
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- 2. iPad Card -->
        <div
          class="card card-hover flex flex-col justify-between overflow-hidden relative min-h-[340px] rounded-lg"
          style="background-image: url('/images/service-ipad.png'); background-size: cover; background-position: center;"
        >
          <div class="absolute inset-0 bg-brand-dark/75"></div>
          <div class="relative z-10 p-6 flex flex-col justify-between h-full text-white">
            <div>
              <div class="w-10 h-10 rounded-lg bg-white/20 flex items-center justify-center text-white mb-4">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                </svg>
              </div>
              <h3 class="font-display font-bold text-white text-xl mb-2">iPad Remonts</h3>
              <p class="text-white/80 text-xs sm:text-sm leading-relaxed">
                Kvalitatīvs visu paaudžu iPad planšetdatoru remonts. Mainām skārienjūtīgos stiklus un LCD displejus, diagnosticējam mātesplates un lādēšanas problēmas.
              </p>
            </div>
            <div class="pt-4 border-t border-white/20">
              <a
                href="/ipad-remonts/"
                class="text-xs font-bold text-white hover:text-brand-orange hover:underline decoration-brand-orange/50 underline-offset-4 inline-flex items-center gap-0.5 transition-all duration-150"
              >
                Uzzināt vairāk
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- 3. Datoru Card -->
        <div
          class="card card-hover flex flex-col justify-between overflow-hidden relative min-h-[340px] rounded-lg"
          style="background-image: url('/images/service-laptop.png'); background-size: cover; background-position: center;"
        >
          <div class="absolute inset-0 bg-brand-dark/75"></div>
          <div class="relative z-10 p-6 flex flex-col justify-between h-full text-white">
            <div>
              <div class="w-10 h-10 rounded-lg bg-white/20 flex items-center justify-center text-white mb-4">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <h3 class="font-display font-bold text-white text-xl mb-2">Datoru Remonts</h3>
              <p class="text-white/80 text-xs sm:text-sm leading-relaxed">
                Apple MacBook un visu zīmolu Windows portatīvo datoru remonts. Veicam dzesēšanas sistēmas apkopi, termopastas maiņu, ekrānu un klaviatūru nomaiņu.
              </p>
            </div>
            <div class="pt-4 border-t border-white/20">
              <a
                href="/datoru-remonts/"
                class="text-xs font-bold text-white hover:text-brand-orange hover:underline decoration-brand-orange/50 underline-offset-4 inline-flex items-center gap-0.5 transition-all duration-150"
              >
                Uzzināt vairāk
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- 4. Dyson Card -->
        <div
          class="card card-hover flex flex-col justify-between overflow-hidden relative min-h-[340px] rounded-lg"
          style="background-image: url('/images/service-dyson.png'); background-size: cover; background-position: center;"
        >
          <div class="absolute inset-0 bg-brand-dark/75"></div>
          <div class="relative z-10 p-6 flex flex-col justify-between h-full text-white">
            <div>
              <div class="w-10 h-10 rounded-lg bg-white/20 flex items-center justify-center text-white mb-4">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              </div>
              <h3 class="font-display font-bold text-white text-xl mb-2">Dyson Remonts</h3>
              <p class="text-white/80 text-xs sm:text-sm leading-relaxed">
                Dyson bezvadu putekļsūcēju, Supersonic fēnu un Airwrap staileru diagnostika un remonts. Novēršam dzinēja un bateriju bojājumus.
              </p>
            </div>
            <div class="pt-4 border-t border-white/20">
              <a
                href="/dyson-puteklsuceju-remonts/"
                class="text-xs font-bold text-white hover:text-brand-orange hover:underline decoration-brand-orange/50 underline-offset-4 inline-flex items-center gap-0.5 transition-all duration-150"
              >
                Uzzināt vairāk
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SEO text block -->
  <section class="py-16 bg-graphite-bg border-b border-white/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 bg-graphite-surface p-8 rounded-lg border border-white/10 text-text-secondary">
      <div class="space-y-6 text-text-secondary leading-relaxed">
        <h2 class="text-3xl font-extrabold text-text-primary tracking-tight">Par iSimple servisa centru</h2>
        <p>
          Uzņēmums iSimple.LV ir dibināts 2021. gadā, apvienojot mobilo tālruņu un portatīvās datortehnikas servisa inženierus ar ilggadēju pieredzi. Jau no pirmajām dienām uzņēmums nodrošina Apple, Samsung, Huawei un citu zīmolu mobilo tālruņu remontu un apkopi. Papildus tam tiek nodrošināts serviss un remonts Apple, DELL, Asus un citu zīmolu portatīvajiem datoriem.
        </p>
        <p>
          iSimple nodrošina Apple, Samsung un citu zīmolu mobilo tālruņu un portatīvās datortehnikas diagnostiku, remontu un servisu. Mūsu uzņēmuma inženieriem ir daudzu gadu pieredze darbā ar dažāda veida tehnoloģiskajām iekārtām, tādēļ nodrošinām ātru, kvalitatīvu un drošu remontu. Noskaidrojiet iespējamās izmaksas piezvanot!
        </p>

        <h3 class="font-display text-2xl font-bold text-text-primary mt-8">Kāpēc klienti <span class="text-brand-orange">izvēlas</span> iSimple?</h3>
        <ul class="space-y-2 text-text-secondary">
          <li class="flex items-start gap-2"><span class="text-brand-orange font-bold mt-0.5">✓</span><span>Bezmaksas diagnostika — maksājat tikai par remontu</span></li>
          <li class="flex items-start gap-2"><span class="text-brand-orange font-bold mt-0.5">✓</span><span>6 mēnešu garantija visiem remonta darbiem</span></li>
          <li class="flex items-start gap-2"><span class="text-brand-orange font-bold mt-0.5">✓</span><span>Lielākā daļa remontu — tajā pašā dienā</span></li>
          <li class="flex items-start gap-2"><span class="text-brand-orange font-bold mt-0.5">✓</span><span>Augstas kvalitātes rezerves daļas</span></li>
          <li class="flex items-start gap-2"><span class="text-brand-orange font-bold mt-0.5">✓</span><span>Pieredzējuši inženieri ar ilggadēju pieredzi</span></li>
          <li class="flex items-start gap-2"><span class="text-brand-orange font-bold mt-0.5">✓</span><span>Ērti pieejams T/C Sāga, Dreiliņos — ar stāvvietu</span></li>
        </ul>

        <h3 class="font-display text-2xl font-bold text-text-primary mt-8">Mūsu <span class="text-brand-orange">pakalpojumi</span></h3>
        <p>
          Servisa centrā iSimple remontējam: iPhone (visi modeļi no iPhone 7), iPad (visi modeļi), Samsung, Huawei, Xiaomi un citu Android tālruņus, Apple MacBook, Dell, Asus, Lenovo, HP portatīvos datorus, kā ari Dyson fēnus, Airwrap stailerus un bezvadu putekļsūcējus.
        </p>
      </div>
    </div>
  </section>

  <!-- Photo strip -->
  <section class="py-16 bg-graphite-bg border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <img
          src="/images/repair-photo-1.png"
          alt="Ekrāna nomaiņa ar aizsargcimdiem"
          class="w-full aspect-[4/3] object-cover rounded-lg border border-white/10"
          loading="lazy"
        />
        <img
          src="/images/repair-photo-2.png"
          alt="Salauzts un jauns iPhone ekrāns"
          class="w-full aspect-[4/3] object-cover rounded-lg border border-white/10"
          loading="lazy"
        />
        <img
          src="/images/old-site/mobile-2510529_1280.jpg"
          alt="Remonta darbavieta ar ierīču detaļām"
          class="w-full aspect-[4/3] object-cover rounded-lg border border-white/10"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Process Section — Kā notiek remonts -->
  <section class="py-20 bg-graphite-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-orange mb-3">Vienkārši un skaidri</p>
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-white tracking-tight">
          Kā notiek <span class="text-brand-orange">remonts</span>
        </h2>
        <p class="mt-4 text-text-secondary">
          {t('process.subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 lg:gap-4">
        {processSteps.map((step) => (
          <div class="relative flex flex-col">
            <!-- Big transparent step number -->
            <span class="text-7xl font-black text-brand-orange/15 leading-none select-none mb-2" aria-hidden="true">
              {step.num}
            </span>
            <h3 class="text-base font-bold text-white mb-2">{step.title}</h3>
            <p class="text-text-muted text-sm leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Review Section -->
  <ReviewsSection lang={lang} />

  <!-- Latest Posts Section -->
  {posts.slice(0, 2).length > 0 && (
    <section class="py-20 bg-graphite-bg border-b border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between mb-12">
          <div>
            <p class="section-label mb-3">{t('latest_posts.label')}</p>
            <h2 class="section-heading">{t('latest_posts.title')}</h2>
          </div>
          <a
            href={getLocalizedPath('/jaunumi/', lang)}
            class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold text-text-secondary hover:text-brand-orange transition-[color] duration-150"
          >
            {t('latest_posts.all_posts')}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {posts.slice(0, 2).map((post) => (
            <a
