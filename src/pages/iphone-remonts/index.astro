---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getIPhoneModels } from '../../lib/sanity';
import { getIPhoneImageUrl } from '../../lib/iphone-images';
import ContactForm from '../../components/ContactForm.astro';

const lang = 'lv';
const models = await getIPhoneModels();

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Sākums", "item": "https://isimple.lv/" },
    { "@type": "ListItem", "position": 2, "name": "iPhone remonts", "item": "https://isimple.lv/iphone-remonts/" }
  ]
};
---

<BaseLayout
  title="iPhone remonts Rīgā — iSimple.lv"
  description="Kvalitatīvs un ātrs iPhone remonts Dreiliņos, T/C Sāga. Ekrāna maiņa, baterijas maiņa un citi pakalpojumi visiem iPhone modeļiem ar garantiju. Bezmaksas diagnostika."
  lang={lang}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero -->
  <section class="bg-graphite-header py-16 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="section-label mb-4">Apple serviss · Dreiliņi, Rīga</p>
        <h1 class="display-heading mb-6">
          iPhone remonts <span class="text-brand-orange">Rīgā</span>
        </h1>
        <p class="text-lg text-text-secondary mb-8 leading-relaxed">
          iSimple servisa centrā veicam profesionālu iPhone remontu visiem modeļiem — no iPhone 7 līdz jaunākajiem iPhone 17 modeļiem. Ekrāna maiņa, baterijas maiņa, lādētāja porta remonts un citi pakalpojumi ar 6 mēnešu garantiju.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 mb-8">
          <a href="tel:+37122487593" class="btn-orange text-lg py-4 px-8">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/>
            </svg>
            Zvanīt: +371 22 487 593
          </a>
        </div>
        <!-- Stats -->
        <div class="grid grid-cols-3 gap-px bg-white/10 border border-white/10 rounded-xl overflow-hidden">
          <div class="px-6 py-5 bg-graphite-surface">
            <p class="text-2xl font-black text-text-primary">20 min</p>
            <p class="text-xs text-text-secondary mt-1 font-medium">Ātrākais remonts</p>
          </div>
          <div class="px-6 py-5 bg-graphite-surface">
            <p class="text-2xl font-black text-text-primary">6 mēn.</p>
            <p class="text-xs text-text-secondary mt-1 font-medium">Garantija darbiem</p>
          </div>
          <div class="px-6 py-5 bg-graphite-surface">
            <p class="text-2xl font-black text-text-primary">0 €</p>
            <p class="text-xs text-text-secondary mt-1 font-medium">Bezmaksas diagnostika</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Models grid -->
  <section class="py-20 bg-graphite-bg border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-extrabold text-text-primary tracking-tight sm:text-4xl mb-4">
          Izvēlieties savu iPhone modeli
        </h2>
        <p class="text-text-secondary text-lg">
          Noklikšķiniet uz modeļa, lai apskatītu detalizētas remonta cenas un pieteiktu remontu.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {models.map((model) => (
          <a
            href={`/iphone-remonts/${model.slug}/`}
            class="bg-graphite-surface p-6 rounded-lg border border-white/10 card-shadow card-shadow-hover block text-center text-text-primary hover:bg-graphite-hover"
          >
            <img
              src={getIPhoneImageUrl(model.slug)}
              alt={model.name}
              class="h-28 w-auto mx-auto object-contain mb-4 drop-shadow-md"
              loading="lazy"
              onerror="this.remove()"
            />
            <span class="text-xs text-text-muted font-bold uppercase tracking-wider block mb-1">Apple</span>
            <h3 class="text-lg font-bold text-text-primary">{model.name}</h3>
            <span class="text-sm font-semibold text-brand-orange mt-4 inline-flex items-center gap-1">
              Skatīt cenas
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SEO text + form -->
  <section class="py-20 bg-graphite-alt border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-8 bg-graphite-surface border border-white/10 p-8 rounded-lg space-y-6 text-text-secondary">
          <img
            src="/images/service-iphone.png"
            alt="Profesionāls iPhone remonts"
            class="w-full aspect-[16/9] object-cover rounded-lg border border-white/10 shadow-sm"
            loading="lazy"
          />
          <h2 class="text-3xl font-extrabold text-text-primary pt-4">Kāpēc izvēlēties iSimple iPhone remontam?</h2>
          <p class="text-text-secondary leading-relaxed">
            iSimple nodrošina Apple, Samsung un citu zīmolu mobilo tālruņu un portatīvās datortehnikas diagnostiku, remontu un servisu. Mūsu uzņēmuma inženieriem ir daudzu gadu pieredze darbā ar dažāda veida tehnoloģiskajām iekārtām, tādēļ nodrošinām ātru, kvalitatīvu un drošu remontu.
          </p>
          <p class="text-text-secondary leading-relaxed">
            iSimple servisa centrs atrodas T/C Sāga, Biķeru ielā 4, Dreiliņos — viegli sasniedzamā vietā ar ērtu stāvvietu. Diagnostiku veicam bez maksas, un lielākajā daļā gadījumu remonts notiek tajā pašā dienā.
          </p>

          <h3 class="text-2xl font-bold text-text-primary pt-4">Biežākie iPhone remonta pakalpojumi</h3>
          <div class="overflow-x-auto rounded-lg border border-white/10">
            <table class="min-w-full divide-y divide-white/10 text-sm">
              <thead class="bg-graphite-header">
                <tr>
                  <th class="px-6 py-3 text-left font-semibold text-text-secondary uppercase tracking-wider">Pakalpojums</th>
                  <th class="px-6 py-3 text-left font-semibold text-text-secondary uppercase tracking-wider">Laiks</th>
                  <th class="px-6 py-3 text-right font-semibold text-text-secondary uppercase tracking-wider">Cena (sākot no)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5 bg-graphite-surface">
                <tr>
                  <td class="px-6 py-4 font-medium text-text-primary">Ekrāna (displeja) maiņa</td>
                  <td class="px-6 py-4 text-text-secondary">20–60 min</td>
                  <td class="px-6 py-4 text-right font-bold text-brand-orange">no 49 €</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-medium text-text-primary">Baterijas (akumulatora) maiņa</td>
                  <td class="px-6 py-4 text-text-secondary">30–60 min</td>
                  <td class="px-6 py-4 text-right font-bold text-brand-orange">no 39 €</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-medium text-text-primary">Lādēšanas porta maiņa (Lightning / USB-C)</td>
                  <td class="px-6 py-4 text-text-secondary">1–2 h</td>
                  <td class="px-6 py-4 text-right font-bold text-brand-orange">no 45 €</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-medium text-text-primary">Aizmugurējā stikla maiņa</td>
                  <td class="px-6 py-4 text-text-secondary">1–3 darba dienas</td>
                  <td class="px-6 py-4 text-right font-bold text-brand-orange">no 59 €</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-medium text-text-primary">Kameras moduļa maiņa</td>
                  <td class="px-6 py-4 text-text-secondary">1–2 h</td>
                  <td class="px-6 py-4 text-right font-bold text-brand-orange">no 55 €</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-medium text-text-primary">Mātesplates remonts / lodēšana</td>
                  <td class="px-6 py-4 text-text-secondary">2–5 darba dienas</td>
                  <td class="px-6 py-4 text-right font-bold text-brand-orange">no 80 €</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-medium text-text-primary">Diagnostika</td>
                  <td class="px-6 py-4 text-text-secondary">30 min</td>
                  <td class="px-6 py-4 text-right font-bold text-brand-orange">Bezmaksas</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="text-xs text-text-muted italic">* Precīzu cenu noteiks pēc bezmaksas diagnostikas. Cenas var atšķirties atkarībā no modeļa un bojājuma veida.</p>

          <h3 class="text-2xl font-bold text-text-primary pt-4">Kā notiek iPhone remonts iSimple?</h3>
          <p class="text-text-secondary leading-relaxed">
            Jūs ienesiet ierīci mūsu servisā, mēs veicam bezmaksas diagnostiku un ziņojam par konstatētajām problēmām un remonta izmaksām. Pēc jūsu apstiprinājuma veicam remontu — lielākajā daļā gadījumu tajā pašā dienā. Katram darbam dodam garantiju.
          </p>
          <p class="text-text-secondary leading-relaxed">
            Uzņēmums iSimple.LV ir dibināts 2021. gadā, apvienojot mobilo tālruņu un portatīvās datortehnikas servisa inženierus ar ilggadēju pieredzi. Jau no pirmajām dienām uzņēmums nodrošina Apple, Samsung, Huawei un citu zīmolu mobilo tālruņu remontu un apkopi.
          </p>
        </div>

        <div class="lg:col-span-4">
          <ContactForm lang={lang} />
        </div>
      </div>
    </div>
  </section>

  <!-- Other services cross-links -->
  <section class="py-12 bg-graphite-bg border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold text-text-primary mb-6">Citi mūsu pakalpojumi</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <a href="/ipad-remonts/" class="bg-graphite-surface rounded-xl p-4 border border-white/10 hover:border-brand-orange transition-all text-center group">
          <p class="font-semibold text-text-primary group-hover:text-brand-orange text-sm">iPad remonts</p>
        </a>
        <a href="/telefonu-remonts/" class="bg-graphite-surface rounded-xl p-4 border border-white/10 hover:border-brand-orange transition-all text-center group">
          <p class="font-semibold text-text-primary group-hover:text-brand-orange text-sm">Telefonu remonts</p>
        </a>
        <a href="/datoru-remonts/" class="bg-graphite-surface rounded-xl p-4 border border-white/10 hover:border-brand-orange transition-all text-center group">
          <p class="font-semibold text-text-primary group-hover:text-brand-orange text-sm">Datoru remonts</p>
        </a>
        <a href="/dyson-puteklsuceju-remonts/" class="bg-graphite-surface rounded-xl p-4 border border-white/10 hover:border-brand-orange transition-all text-center group">
          <p class="font-semibold text-text-primary group-hover:text-brand-orange text-sm">Dyson remonts</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
