---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';

const lang = 'lv';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Sākums", "item": "https://isimple.lv/" },
    { "@type": "ListItem", "position": 2, "name": "iPad remonts", "item": "https://isimple.lv/ipad-remonts/" }
  ]
};
---

<BaseLayout
  title="iPad remonts Rīgā — iSimple.lv"
  description="Profesionāls iPad remonts Dreiliņos, Rīgā. Stikla maiņa, displeja moduļa nomaiņa, lādēšanas ligzdas remonts un bateriju nomaiņa visiem iPad modeļiem ar garantiju."
  lang={lang}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero -->
  <section class="bg-graphite-header pt-16 pb-12 border-b border-white/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="section-label mb-4">Apple serviss · Dreiliņi, Rīga</p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-text-primary tracking-tight mb-6">
        iPad remonts <span class="text-brand-orange">Rīgā</span>
      </h1>
      <p class="text-lg text-text-secondary max-w-2xl mx-auto mb-8 leading-relaxed">
        Mūsu servisa centrā iSimple veicam jebkuras sarežģītības iPad planšetdatoru remontu. Neatkarīgi no tā, vai Jums ir klasiskais iPad, iPad Air, iPad mini vai jaudīgais iPad Pro — mēs palīdzēsim atgriezt Jūsu ierīci darba kārtībā.
      </p>

      <!-- Giant call button -->
      <div class="flex flex-col sm:flex-row gap-3 justify-center items-center mb-10 max-w-md mx-auto">
        <a
          href="tel:+37122487593"
          class="inline-flex items-center justify-center gap-2 bg-brand-orange hover:bg-brand-orange-hover text-graphite-header font-bold text-base py-3 px-6 rounded-lg transition-all duration-150 active:scale-[0.98] w-full sm:w-auto"
        >
          📞 Zvanīt: +371 22 487 593
        </a>
        <a
          href="/kontakti/"
          class="btn-secondary w-full sm:w-auto"
        >
          Pieteikt remontu
        </a>
      </div>

      <!-- Stats strip -->
      <div class="flex flex-wrap items-center justify-between gap-y-3 gap-x-6 p-4 bg-graphite-surface border border-white/10 rounded-lg text-sm text-text-secondary font-medium max-w-lg mx-auto">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-orange"></span>
          <span>Ātrākais remonts: <strong class="text-text-primary font-semibold">1–2 d.</strong></span>
        </div>
        <span class="hidden md:inline text-white/10">|</span>
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-orange"></span>
          <span>Garantija: <strong class="text-text-primary font-semibold">6 mēn.</strong></span>
        </div>
        <span class="hidden md:inline text-white/10">|</span>
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-orange"></span>
          <span>Diagnostika: <strong class="text-text-primary font-semibold">0 €</strong></span>
        </div>
      </div>
    </div>
  </section>

  <!-- Content + form -->
  <section class="py-20 bg-graphite-bg border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-8 space-y-8">
          <div class="bg-graphite-surface p-8 rounded-lg border border-white/10 space-y-6 text-text-secondary">
            <span class="text-xs text-brand-orange font-bold uppercase tracking-wider block">iPad remonts</span>

            <img
              src="/images/ipad/ipad-desk-front.webp"
              alt="Meistars labo iPad planšetdatoru"
              class="w-full aspect-[16/9] object-cover rounded-lg border border-white/10 shadow-sm"
              loading="eager"
            />

            <h2 class="text-2xl font-bold text-text-primary pt-4">Biežākie iPad remonta veidi un cenas</h2>
            <div class="overflow-x-auto rounded-lg border border-white/10">
              <table class="min-w-full divide-y divide-white/10 text-sm">
                <thead class="bg-graphite-header">
                  <tr>
                    <th class="px-6 py-3 text-left font-semibold text-text-secondary uppercase tracking-wider">Pakalpojums</th>
                    <th class="px-6 py-3 text-left font-semibold text-text-secondary uppercase tracking-wider">Laiks</th>
                    <th class="px-6 py-3 text-right font-semibold text-text-secondary uppercase tracking-wider">Cena (sākot no)</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/5 bg-graphite-surface">
                  <tr>
                    <td class="px-6 py-4 font-medium text-text-primary">Stikla / Skārienjūtīgā ekrāna maiņa (iPad 7/8/9/10)</td>
                    <td class="px-6 py-4 text-text-secondary">1–2 darba dienas</td>
                    <td class="px-6 py-4 text-right font-bold text-brand-orange">no 60 €</td>
                  </tr>
                  <tr>
                    <td class="px-6 py-4 font-medium text-text-primary">Displeja moduļa maiņa (iPad Air, Pro, mini)</td>
                    <td class="px-6 py-4 text-text-secondary">1–2 darba dienas</td>
                    <td class="px-6 py-4 text-right font-bold text-brand-orange">no 110 €</td>
                  </tr>
                  <tr>
                    <td class="px-6 py-4 font-medium text-text-primary">Akumulatora (Baterijas) nomaiņa</td>
                    <td class="px-6 py-4 text-text-secondary">1–2 darba dienas</td>
                    <td class="px-6 py-4 text-right font-bold text-brand-orange">no 50 €</td>
                  </tr>
                  <tr>
                    <td class="px-6 py-4 font-medium text-text-primary">Lādēšanas ligzdas / audio ligzdas remonts</td>
                    <td class="px-6 py-4 text-text-secondary">1 darba diena</td>
                    <td class="px-6 py-4 text-right font-bold text-brand-orange">no 45 €</td>
                  </tr>
                  <tr>
                    <td class="px-6 py-4 font-medium text-text-primary">Mātesplates remonts, lodēšanas darbi</td>
                    <td class="px-6 py-4 text-text-secondary">2–5 darba dienas</td>
                    <td class="px-6 py-4 text-right font-bold text-brand-orange">no 70 €</td>
                  </tr>
                  <tr>
                    <td class="px-6 py-4 font-medium text-text-primary">Diagnostika</td>
                    <td class="px-6 py-4 text-text-secondary">30 min</td>
                    <td class="px-6 py-4 text-right font-bold text-brand-orange">Bezmaksas</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="text-xs text-text-muted italic">* Cenas var atšķirties atkarībā no iPad paaudzes un modeļa. Precīzu cenu noteiksim pēc bezmaksas diagnostikas.</p>

            <h3 class="text-xl font-bold text-text-primary pt-4">Par mūsu iPad servisu</h3>
            <p class="text-text-secondary leading-relaxed">
              iSimple servisa centrā strādā pieredzējuši inženieri, kas specializējas Apple ierīču remontā. Mēs izmantojam augstas kvalitātes rezerves daļas un nodrošinām 6 mēnešu garantiju visiem remonta darbiem. Servisa centrs atrodas T/C Sāga, Biķeru ielā 4, Dreiliņos — viegli pieejams no Rīgas centra.
            </p>
          </div>
        </div>
        <div class="lg:col-span-4">
          <ContactForm lang={lang} />
        </div>
      </div>
    </div>
  </section>

  <!-- Other services cross-links -->
  <section class="py-12 bg-graphite-alt border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold text-text-primary mb-6">Citi mūsu pakalpojumi</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <a href="/iphone-remonts/" class="bg-graphite-surface rounded-lg p-4 border border-white/10 hover:border-brand-orange hover:shadow-md transition-all text-center group">
          <p class="font-semibold text-text-secondary group-hover:text-brand-orange text-sm">iPhone remonts</p>
        </a>
        <a href="/telefonu-remonts/" class="bg-graphite-surface rounded-lg p-4 border border-white/10 hover:border-brand-orange hover:shadow-md transition-all text-center group">
          <p class="font-semibold text-text-secondary group-hover:text-brand-orange text-sm">Telefonu remonts</p>
        </a>
        <a href="/datoru-remonts/" class="bg-graphite-surface rounded-lg p-4 border border-white/10 hover:border-brand-orange hover:shadow-md transition-all text-center group">
          <p class="font-semibold text-text-secondary group-hover:text-brand-orange text-sm">Datoru remonts</p>
        </a>
        <a href="/dyson-puteklsuceju-remonts/" class="bg-graphite-surface rounded-lg p-4 border border-white/10 hover:border-brand-orange hover:shadow-md transition-all text-center group">
          <p class="font-semibold text-text-secondary group-hover:text-brand-orange text-sm">Dyson remonts</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
