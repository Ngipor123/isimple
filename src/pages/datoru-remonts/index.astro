---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';

const lang = 'lv';

const title = 'Datoru remonts Rīgā — iSimple.lv';
const description = 'Profesionāls portatīvo datoru un MacBook remonts Dreiliņos, Rīgā. Apple MacBook, Dell, Asus, Lenovo, HP datoru remonts ar garantiju. Bezmaksas diagnostika.';

const siteUrl = 'https://isimple.lv';
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Sākums", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Datoru remonts", "item": `${siteUrl}/datoru-remonts/` }
  ]
};

interface PriceRow {
  service: string;
  time: string;
  price: string;
}

const priceRows: PriceRow[] = [
  { service: 'Ekrāna (displeja) maiņa', time: '1–2 darba dienas', price: 'no 79 €' },
  { service: 'Tastatūras maiņa', time: '1 darba diena', price: 'no 49 €' },
  { service: 'SSD / HDD maiņa vai uzstādīšana', time: '1 darba diena', price: 'no 35 €' },
  { service: 'RAM paplašināšana', time: '30–60 min', price: 'no 15 €' },
  { service: 'Barošanas bloka / lādētāja porta remonts', time: '1–2 darba dienas', price: 'no 45 €' },
  { service: 'Dzesēšanas sistēmas tīrīšana un termopastas maiņa', time: '1 darba diena', price: 'no 30 €' },
  { service: 'Mātesplates remonts', time: '3–7 darba dienas', price: 'no 80 €' },
  { service: 'Operētājsistēmas instalēšana / atjaunošana', time: '1–2 h', price: 'no 25 €' },
  { service: 'Diagnostika', time: '30–60 min', price: 'Bezmaksas' },
];
---

<BaseLayout title={title} description={description} lang={lang}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero Section -->
  <section class="bg-graphite-header pt-16 pb-12 border-b border-white/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="section-label mb-4">Servisa centrs · T/C Sāga, Biķeru iela 4, Dreiliņi</p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-text-primary tracking-tight mb-6">
        Datoru un portatīvo datoru remonts <span class="text-brand-orange">Rīgā</span>
      </h1>
      <p class="text-lg text-text-secondary max-w-2xl mx-auto mb-8 leading-relaxed">
        iSimple nodrošina Apple MacBook, Dell, Asus, Lenovo, HP un citu zīmolu portatīvo datoru diagnostiku, remontu un servisu Dreiliņos, Rīgā.
      </p>

      <!-- Giant call button -->
      <div class="flex flex-col sm:flex-row gap-3 justify-center items-center mb-10 max-w-md mx-auto">
        <a
          href="tel:+37122487593"
          class="inline-flex items-center justify-center gap-2 bg-brand-orange hover:bg-brand-orange-hover text-graphite-header font-bold text-base py-3 px-6 rounded-lg transition-all duration-150 active:scale-[0.98] w-full sm:w-auto"
        >
          📞 Zvanīt: +371 22 487 593
        </a>
        <a
          href="/kontakti/"
          class="btn-secondary w-full sm:w-auto"
        >
          Pieteikt remontu
        </a>
      </div>

      <!-- Stats strip -->
      <div class="flex flex-wrap items-center justify-between gap-y-3 gap-x-6 p-4 bg-graphite-surface border border-white/10 rounded-lg text-sm text-text-secondary font-medium max-w-lg mx-auto">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-orange"></span>
          <span>Ātrākais remonts: <strong class="text-text-primary font-semibold">1 diena</strong></span>
        </div>
        <span class="hidden md:inline text-white/10">|</span>
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-orange"></span>
          <span>Garantija: <strong class="text-text-primary font-semibold">6 mēn.</strong></span>
        </div>
        <span class="hidden md:inline text-white/10">|</span>
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-orange"></span>
          <span>Diagnostika: <strong class="text-text-primary font-semibold">0 €</strong></span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main content -->
  <div class="py-16 bg-graphite-bg border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">

        <!-- Content -->
        <div class="lg:col-span-8 space-y-8">
          <div class="bg-graphite-surface p-8 rounded-lg border border-white/10 space-y-6 text-text-secondary">
            <span class="text-xs text-brand-orange font-bold uppercase tracking-wider block">MacBook, Dell, Asus, Lenovo, HP remonts</span>

            <img
              src="/images/service-laptop.png"
              alt="Portatīvo datoru un MacBook remonts servisa centrā"
              class="w-full aspect-[16/9] object-cover rounded-lg border border-white/10 shadow-sm"
              loading="eager"
            />

            <h2 class="text-2xl font-bold text-text-primary pt-4">Remonta cenas un laiki</h2>

            <div class="overflow-x-auto rounded-lg border border-white/10">
              <table class="min-w-full divide-y divide-white/10 text-sm">
                <thead class="bg-graphite-header">
                  <tr>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-text-secondary uppercase tracking-wider">Pakalpojums</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-text-secondary uppercase tracking-wider">Laiks</th>
                    <th scope="col" class="px-6 py-3 text-right font-semibold text-text-secondary uppercase tracking-wider">Cena (sākot no)</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/5 bg-graphite-surface">
                  {priceRows.map((row) => (
                    <tr>
                      <td class="px-6 py-4 font-medium text-text-primary">{row.service}</td>
                      <td class="px-6 py-4 text-text-secondary">{row.time}</td>
                      <td class="px-6 py-4 text-right font-bold text-brand-orange">{row.price}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <p class="text-xs text-text-muted italic">
              * Cenas var atšķirties atkarībā no ierīces modeļa un bojājuma veida. Precīzu cenu noteiksim pēc bezmaksas diagnostikas.
            </p>

            <!-- SEO text -->
            <div class="space-y-4 text-text-secondary leading-relaxed">
              <h2 class="text-2xl font-bold text-text-primary">Profesionāls datoru serviss Dreiliņos</h2>
              <p>
                iSimple nodrošina <strong>Apple MacBook, Dell, Asus, Lenovo, HP, Acer</strong> un citu zīmolu portatīvo datoru 
                diagnostiku, remontu un servisu Dreiliņos, Rīgā. Mūsu uzņēmuma inženieriem ir daudzu gadu pieredze darbā ar 
                dažāda veida tehnoloģiskajām iekārtām.
              </p>
              <p>
                Papildus mobilo tālruņu remontam, iSimple nodrošina servisu un remontu Apple, DELL, Asus un citu zīmolu 
                portatīvajiem datoriem. Katrs remonts tiek veikts ar <strong>augstas kvalitātes rezerves daļām</strong>.
              </p>
              <p>
                Pirms remonta veicam bezmaksas diagnostiku un informējam par precīzajām izmaksām. 
                Remonts tiek veikts tikai pēc <strong>jūsu apstiprinājuma</strong>.
              </p>
            </div>
          </div>
        </div>

        <!-- Form Sidebar -->
        <div class="lg:col-span-4">
          <ContactForm lang={lang} />
        </div>

      </div>
    </div>
  </div>

  <!-- Other services cross-links -->
  <section class="py-12 bg-graphite-alt border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold text-text-primary mb-6">Citi mūsu pakalpojumi</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <a href="/iphone-remonts/" class="bg-graphite-surface rounded-lg p-4 border border-white/10 hover:border-brand-orange hover:shadow-md transition-all text-center group">
          <p class="font-semibold text-text-secondary group-hover:text-brand-orange text-sm">iPhone remonts</p>
        </a>
        <a href="/ipad-remonts/" class="bg-graphite-surface rounded-lg p-4 border border-white/10 hover:border-brand-orange hover:shadow-md transition-all text-center group">
          <p class="font-semibold text-text-secondary group-hover:text-brand-orange text-sm">iPad remonts</p>
        </a>
        <a href="/telefonu-remonts/" class="bg-graphite-surface rounded-lg p-4 border border-white/10 hover:border-brand-orange hover:shadow-md transition-all text-center group">
          <p class="font-semibold text-text-secondary group-hover:text-brand-orange text-sm">Telefonu remonts</p>
        </a>
        <a href="/dyson-puteklsuceju-remonts/" class="bg-graphite-surface rounded-lg p-4 border border-white/10 hover:border-brand-orange hover:shadow-md transition-all text-center group">
          <p class="font-semibold text-text-secondary group-hover:text-brand-orange text-sm">Dyson remonts</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
