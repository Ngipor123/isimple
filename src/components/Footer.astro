---
const year = new Date().getFullYear();
---

<footer class="bg-graphite-header text-text-secondary pt-14 pb-8 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 pb-12 border-b border-white/10">
      
      <!-- Column 1: Info -->
      <div class="space-y-4">
        <a href="/" class="inline-block">
          <img src="/images/isimple_logo_BALTS.png.webp" alt="iSimple.lv" class="w-48 h-auto object-contain" />
        </a>
        <p class="text-text-secondary text-sm max-w-sm">
          Profesionāls mobilo tālruņu, datoru un Dyson ierīču remonta serviss Dreiliņos, Rīgā.
        </p>
        <div class="flex space-x-4 pt-2">
          <a href="https://www.facebook.com/isimple.lv" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-text-primary transition-[color] duration-150">
            <span class="sr-only">Facebook</span>
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Links -->
      <div>
        <h3 class="text-xs font-semibold text-text-primary uppercase tracking-wider mb-4">Pakalpojumi</h3>
        <ul class="space-y-3">
          <li><a href="/iphone-remonts/" class="text-text-secondary hover:text-text-primary text-sm hover:underline decoration-brand-orange/50 underline-offset-4 transition-all duration-150">iPhone remonts</a></li>
          <li><a href="/ipad-remonts/" class="text-text-secondary hover:text-text-primary text-sm hover:underline decoration-brand-orange/50 underline-offset-4 transition-all duration-150">iPad remonts</a></li>
          <li><a href="/telefonu-remonts/" class="text-text-secondary hover:text-text-primary text-sm hover:underline decoration-brand-orange/50 underline-offset-4 transition-all duration-150">Telefonu remonts</a></li>
          <li><a href="/datoru-remonts/" class="text-text-secondary hover:text-text-primary text-sm hover:underline decoration-brand-orange/50 underline-offset-4 transition-all duration-150">Datoru remonts</a></li>
          <li><a href="/dyson-puteklsuceju-remonts/" class="text-text-secondary hover:text-text-primary text-sm hover:underline decoration-brand-orange/50 underline-offset-4 transition-all duration-150">Dyson remonts</a></li>
          <li><a href="/par-mums/" class="text-text-secondary hover:text-text-primary text-sm hover:underline decoration-brand-orange/50 underline-offset-4 transition-all duration-150">Par mums</a></li>
          <li><a href="/kontakti/" class="text-text-secondary hover:text-text-primary text-sm hover:underline decoration-brand-orange/50 underline-offset-4 transition-all duration-150">Kontakti</a></li>
        </ul>
      </div>

      <!-- Column 3: Contact Details -->
      <div class="space-y-4">
        <h3 class="text-xs font-semibold text-text-primary uppercase tracking-wider mb-4">Kontakti</h3>
        <p class="text-text-secondary text-sm">
          <strong>Adrese:</strong> T/C Sāga, Biķeru iela 4, Dreiliņi, Ropažu novads
        </p>
        <p class="text-text-secondary text-sm">
          <strong>Tālrunis:</strong> <a href="tel:+37122487593" class="hover:text-text-primary transition-[color] duration-150">+371 22 487 593</a>
        </p>
        <p class="text-text-secondary text-sm">
          <strong>E-pasts:</strong> <a href="mailto:info@isimple.lv" class="hover:text-text-primary transition-[color] duration-150">info@isimple.lv</a>
        </p>
        <p class="text-text-secondary text-sm">
          <strong>Darba laiks:</strong><br/>
          P–Sestd: 10:00–21:00<br/>
          Svētd: 10:00–20:00
        </p>
      </div>

    </div>

    <!-- Copyright -->
    <div class="mt-8 flex flex-col md:flex-row justify-between items-center text-xs text-text-muted">
      <p>&copy; {year} iSimple.lv. Visas tiesības aizsargātas.</p>
      <p class="mt-2 md:mt-0">Dreiliņi, Rīga, Latvija</p>
    </div>
  </div>
</footer>
