---
// Floating call button — always visible, bottom-right corner
---

<a
  href="tel:+37122487593"
  class="floating-call-btn"
  aria-label="Zvanīt: +371 22 487 593"
>
  <!-- Phone icon -->
  <svg class="icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/>
  </svg>
  <span class="label desktop-label">Zvanīt</span>
  <span class="label mobile-label">Zvanīt: +371 22 487 593</span>
</a>

<style>
  .floating-call-btn {
    position: fixed;
    bottom: 85px;
    right: 28px;
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 10px;
    background: #F97316;
    color: #fff;
    font-weight: 700;
    font-size: 1.1rem;
    padding: 16px 28px;
    border-radius: 999px;
    box-shadow: 0 8px 32px rgba(249,115,22,0.45), 0 2px 8px rgba(0,0,0,0.18);
    text-decoration: none;
    transition: background 0.18s, transform 0.18s, box-shadow 0.18s;
    letter-spacing: 0.02em;
  }

  .floating-call-btn:hover,
  .floating-call-btn:focus-visible {
    background: #ea6700;
    transform: scale(1.06);
    box-shadow: 0 12px 40px rgba(249,115,22,0.55), 0 2px 8px rgba(0,0,0,0.22);
    outline: none;
  }

  .floating-call-btn:active {
    transform: scale(0.97);
  }

  .icon {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
  }

  /* Desktop: show short label only */
  .mobile-label { display: none; }
  .desktop-label { display: inline; }

  /* On mobile: compact floating button on the right */
  @media (max-width: 639px) {
    .floating-call-btn {
      bottom: 24px;
      right: 20px;
      left: auto;
      width: auto;
      border-radius: 999px;
      padding: 16px;
      justify-content: center;
      box-shadow: 0 8px 24px rgba(249,115,22,0.45), 0 2px 8px rgba(0,0,0,0.18);
    }
    .mobile-label { display: none; }
    .desktop-label { display: none; }
    .icon {
      width: 26px;
      height: 26px;
    }
  }
</style>
